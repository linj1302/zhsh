<% var _sd = ''; if (item && item.info && item.info.strengthenLevel) { var _d = user.getStrengthenDisplay(item.info.strengthenLevel); if (_d) { _sd = ' <span style="font-size:0.85em;color:' + _d.color + '">' + _d.symbol + _d.tag + ' [+' + item.info.strengthenLevel + ']</span>'; } } -%>
