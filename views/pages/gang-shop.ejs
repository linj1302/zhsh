<div>
    <!-- 操作结果提示 -->
    <% if (typeof tip !== 'undefined' && tip && typeof tip === 'string' && tip.length > 0) { %>
        <div style="margin: 10px 0; padding: 8px; background: #f5f5f5; color: <%= tip.includes('成功') ? 'green' : 'red' %>;">
            <%= tip %>
        </div>
    <% } %>

    <!-- 错误信息显示 -->
    <% var play = user.getPlay() %>
    <% var hasGang = gangInfo && gangInfo.id %>

    <% if (hasGang) { %>
        <!-- 货币信息 -->
        <div>
            <div>
                <span>金贝：</span><span><%= play.gold %></span>
                <a href="exchange?changeType=1">兑换银贝</a>
            </div>
            <div>
                <span>银贝：</span><span><%= play.showSilver %></span>
                <span>铜币：</span><span><%= play.showCopper %></span>
                <a href="exchange?changeType=2">兑换金贝</a>
            </div>
        </div>

        <% if (typeof shopItems !== 'undefined' && shopItems && shopItems.length > 0) { %>  
            <!-- 商品列表 -->
            <div>
                <% shopItems.forEach(function(item, index) { %>
                    <div>
                        <span style="margin-right: 5px;"><%= index + 1 %>.</span>
                        <% if (item.image) { %>
                            <img src="<%= item.image %>" style="width: 20px; height: 20px;">
                        <% } %>
                        <a><%= item.name %></a>
                        <span style="margin-left: 5px;">(<%= item.level %>级)</span>
                        <span style="margin-left: 10px;">(<%= item.price %>帮贡)</span>

                        <!-- 🔑 每月限购信息 -->
                        <% if (item.monthlyLimit) { %>
                        <span>每月限购(0/<%= item.monthlyLimit %>)</span>
                        <% } %>

                        <!-- 🔑 购买按钮 -->
                        <span>
                            <a href="/gang-shop?type=buyGangItem&params=<%= item.id %>" style="margin-left: 10px;">购买</a>
                        </span>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div>商店暂无商品</div>
        <% } %>
    <% } else { %>
        <div>您还没有加入任何帮会</div>
    <% } %>
</div>
