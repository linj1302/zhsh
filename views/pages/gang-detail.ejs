<div>
    <div style="margin: 10px 0px;">
        【帮会详情】
    </div>

    <% if (typeof gang !== 'undefined' && gang) { %>
        <div>
            帮会名称: <span><%= gang.name %></span>
        </div>

        <div>
            帮会等级: <span><%= gang.level %></span>
        </div>

        <div>
            帮会资金: <span><%= gang.fund %></span>
        </div>

        <div>
            帮会成员数: <span><%= gangMembers.length %>/<%= gang.max_members %></span>
        </div>

        <div>
            帮会公告: <span><%= gang.notice %></span>
        </div>

        <div style="margin-top: 20px;">
            <div>帮会成员:</div>
            <% if (gangMembers.length > 0) { %>
                <div>
                    <% gangMembers.forEach(function(member) { %>
                        <div>
                            <span>
                                <% if (member.role === 'leader') { %>
                                    [帮主]
                                <% } else if (member.role === 'elder') { %>
                                    [长老]
                                <% } else { %>
                                    [成员]
                                <% } %>
                            </span>
                            <span><%= member.username %></span>
                            <span>(贡献: <%= member.contribution %>)</span>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div>暂无成员</div>
            <% } %>
        </div>

        <% if (isMember) { %>
            <div style="margin-top: 20px;">
                <a href="/my-gang">进入我的帮会</a>
            </div>
        <% } else { %>
            <div style="margin-top: 20px;">
                <a href="/my-gang?type=joinGang&gangId=<%= gang.id %>">加入帮会</a>
            </div>
        <% } %>
    <% } else { %>
        <div>帮会不存在</div>
    <% } %>
</div>
