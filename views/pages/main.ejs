<% var play = user.getPlay() %>
<% var city = user.getCity() %>

<!-- ═══ 位置信息 ═══ -->
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; padding:6px 10px; background:#f8f9fa; border-radius:5px; font-size:0.85em;">
    <div>
        <span style="color:#888; font-size:0.85em;">📍</span>
        <strong><%= city.city %></strong>
        <span style="color:#666;">· <%= city.position %><%= city.position === '码头' ? ' ★' : '' %></span>
    </div>
    <a href="/main" style="font-size:0.82em; color:#1565c0;">刷新</a>
</div>

<!-- ═══ 附近玩家 ═══ -->
<%
const onlineUsers = user.getOnlineUsersInLocation();
if (onlineUsers && onlineUsers.length > 0) {
    const displayUsers = onlineUsers.slice(0, 2);
%>
<div style="font-size:0.82em; color:#888; margin-bottom:6px;">
    <span>附近：</span>
    <% displayUsers.forEach(function(u) { %>
        <a href="/role-status?userId=<%= u.id %>" style="color:#555;"><%= u.nickname || u.username %></a>
    <% }); %>
    <% if (onlineUsers.length > 2) { %><a href="/online-users" style="color:#999;">…</a><% } %>
</div>
<% } %>

<!-- ═══ 场景 ═══ -->
<div class="section" style="padding:8px 10px;">
    <% var allNpcs = user.getNpc() %>
    <% var allMonsters = user.getNpc(true) %>

    <!-- 场景内容：固定最大高度，超出滚动 -->
    <div class="scroll-box" style="max-height:108px;">
        <% if (allNpcs.length > 0) { %>
        <div style="display:flex; flex-wrap:wrap; column-gap:12px; row-gap:3px; margin-bottom:5px; align-items:center;">
            <% for (let i in allNpcs) { %>
                <% let npc = allNpcs[i] %>
                <% const availableTasks = user.task.getAvailableTasksForNpc(npc.name); %>
                <% const submittableTasks = user.task.getSubmittableTasksForNpc(npc.name); %>
                <span style="white-space:nowrap;">
                    <% if (submittableTasks.length > 0) { %><%- include('./assets/wen') %><% } %>
                    <% if (submittableTasks.length === 0 && availableTasks.length > 0) { %><%- include('./assets/tan') %><% } %>
                    <a href="<%= user.npc.getHref(npc) %>"><%= npc.name %></a>
                </span>
            <% } %>
        </div>
        <% } %>

        <% if (allMonsters.length > 0) { %>
        <div style="display:flex; flex-wrap:wrap; column-gap:12px; row-gap:3px; align-items:center;">
            <% for (let i in allMonsters) { %>
                <% let mon = allMonsters[i] %>
                <span style="white-space:nowrap;">
                    <a href="/attack?type=monster.assault&params=<%= mon.name + "," + mon.level %>" style="color:#c62828;"><%= mon.name %> <small>(<%= mon.level %>级)</small></a>
                </span>
            <% } %>
        </div>
        <% } %>
    </div>

    <!-- 出口 -->
    <div style="font-size:0.85em; color:#888; margin-top:4px;">
        出口：
        <% var dirs = user.getCity().getDirs ? user.getCity().getDirs() : (user.city.getDirs()) %>
        <% for (let i in dirs) { let dir = dirs[i] %>
            <a href="/main?type=city.move&params=<%= dir.value %>" style="margin:0 4px;"><%= dir.label %></a>
        <% } %>
    </div>
</div>

<!-- ═══ 城内地图（中国传统城市布局：居中而王、面朝后市、左祖右社）═══ -->
<div style="margin:6px 0; border:1px solid #eee; border-radius:6px; padding:6px 8px; background:#fafbfc;">
    <div style="text-align:center; margin-bottom:3px;">
        <a href="/city-map" style="font-size:0.85em; color:#1565c0; letter-spacing:2px;">[ 城 内 地 图 ]</a>
    </div>
    <%- include('common/city-grid', { spots: user.city.getInsideMap(), currentPos: city.position }) %>
</div>

