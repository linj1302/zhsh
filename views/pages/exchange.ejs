<div>
    <% var play = user.getPlay() %>
    <% var changeType = query.changeType %>
    <div>
        <span>当前金贝：</span><span><%= play.gold %></span>
        <div>当前银元: <span><%= play.showSilver %></span></div>
    </div>

    <!-- 兑换比例 -->
    <div>
        <% if (changeType == 1) { %>
            兑换比例: <span>1金贝 = <span>300</span>银元</span>
        <% } else { %>
            兑换比例: <span>500银元 = <span>1</span>金贝</span>
        <% } %>
    </div>

    <!-- 兑换表单 -->
    <form method="get" action="exchange">
        <input type="hidden" name="changeType" value="<%= changeType %>">
        <input type="hidden" name="type" value="npc.exchangeCoin">

        <div>
            <% if (changeType == 1) { %>
                兑换数量:
                <input type="number" name="count" placeholder="请输入要兑换的金贝数量" min="1" step="1">
            <% } else { %>
                兑换数量:
                <input type="number" name="count" placeholder="请输入要兑换的银元数量" min="1" step="1">
            <% } %>
        </div>

        <div>
            <% if (changeType == 1) { %>
                可获得银元: <span id="calculatedSilver">0</span>
            <% } else { %>
                消耗银元: <span id="calculatedGold">0</span>
            <% } %>
        </div>

        <div style="margin-top: 20px;">
            <div>
                <input type="submit" value="确认兑换">
            </div>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const changeType = '<%= changeType %>';
        const countInput = document.querySelector('input[name="count"]');
        const calculatedSilver = document.getElementById('calculatedSilver');
        const calculatedGold = document.getElementById('calculatedGold');

        countInput.addEventListener('input', function () {
            const count = parseInt(this.value) || 0;
            if (changeType == 1) {
                // 金贝兑换银元: 1金贝 = 300银元
                const silver = count * 300;
                calculatedSilver.textContent = silver;
            } else {
                // 银元兑换金贝: 500银元 = 1金贝
                const silverNeeded = count * 500;
                calculatedGold.textContent = silverNeeded;
            }
        });
    });
</script>
